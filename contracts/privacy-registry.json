{
  "schema_version": "agent-runtime-privacy-registry/1.0",
  "rules": [
    {"field_pattern": "^binding\\.(id|host_id|server_name|command_basename|confidence)$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded binding identifiers, safe basename, and evidence confidence", "threat_ids": ["T-SECRET-DISCLOSURE", "T-FORGED-EXPECTATION"]},
    {"field_pattern": "^binding\\.(command_path_hash|config_source_hash)$", "class": "HASH_ONLY", "projection": "emit domain-separated prefixed SHA-256 only", "threat_ids": ["T-SECRET-DISCLOSURE", "T-FORGED-EXPECTATION"]},
    {"field_pattern": "^binding\\.argument_fingerprints\\[\\]\\.position$", "class": "PUBLIC", "projection": "emit bounded numeric argument position", "threat_ids": ["T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^binding\\.argument_fingerprints\\[\\]\\.sha256$", "class": "HASH_ONLY", "projection": "emit domain-separated prefixed SHA-256 only", "threat_ids": ["T-SECRET-DISCLOSURE", "T-PROOF-TAMPERING"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.schema_version$", "class": "PUBLIC", "projection": "emit exact schema version", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.subject\\.(id|display_name|version)$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded declared identity", "threat_ids": ["T-SECRET-DISCLOSURE", "T-FORGED-EXPECTATION"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.launch\\.kind$", "class": "PUBLIC", "projection": "emit enum", "threat_ids": ["T-CONFIG-EXECUTION"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.launch\\.entrypoint$", "class": "LOCAL_EXPLICIT_ONLY", "projection": "keep local; public Proof emits a path hash and safe basename", "threat_ids": ["T-PATH-ESCAPE", "T-SECRET-DISCLOSURE", "T-CONFIG-EXECUTION"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.launch\\.argument_fingerprints\\[\\]\\.position$", "class": "PUBLIC", "projection": "emit bounded numeric position", "threat_ids": ["T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.launch\\.argument_fingerprints\\[\\]\\.sha256$", "class": "HASH_ONLY", "projection": "emit lowercase SHA-256 only", "threat_ids": ["T-SECRET-DISCLOSURE", "T-PROOF-TAMPERING"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.artifact\\.root$", "class": "LOCAL_EXPLICIT_ONLY", "projection": "keep resolved root local; public output uses hash", "threat_ids": ["T-PATH-ESCAPE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.artifact\\.(include|exclude)\\[\\]$", "class": "LOCAL_EXPLICIT_ONLY", "projection": "keep declared glob locally with expectation", "threat_ids": ["T-PATH-ESCAPE", "T-SECRET-DISCLOSURE", "T-RESOURCE-EXHAUSTION"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.artifact\\.sha256$", "class": "HASH_ONLY", "projection": "emit lowercase SHA-256", "threat_ids": ["T-TOCTOU", "T-PROOF-TAMPERING"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.artifact\\.(max_files|max_bytes|max_duration_ms)$", "class": "PUBLIC", "projection": "emit active integer bound", "threat_ids": ["T-RESOURCE-EXHAUSTION"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.policy\\.allowed_roots\\[\\]$", "class": "LOCAL_EXPLICIT_ONLY", "projection": "keep root local; expose hash if evidence requires it", "threat_ids": ["T-PATH-ESCAPE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.policy\\.allow_symlinks$", "class": "PUBLIC", "projection": "emit policy boolean", "threat_ids": ["T-PATH-ESCAPE"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.source\\.(kind|trust)$", "class": "PUBLIC", "projection": "emit enum", "threat_ids": ["T-FORGED-EXPECTATION"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.source\\.locator_hash$", "class": "HASH_ONLY", "projection": "emit lowercase SHA-256", "threat_ids": ["T-FORGED-EXPECTATION", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^(expectation|fixture\\.expectation)\\.extensions\\.\\*$", "class": "PROHIBITED", "projection": "omit unless a later namespaced contract adds an explicit field classification", "threat_ids": ["T-SECRET-DISCLOSURE", "T-CONFIG-EXECUTION"]},

    {"field_pattern": "^fixture\\.schema_version$", "class": "PUBLIC", "projection": "emit exact schema version", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^fixture\\.fixture_id$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded synthetic identifier", "threat_ids": ["T-TEST-STATE-POLLUTION"]},
    {"field_pattern": "^fixture\\.platform\\.(os|arch)$", "class": "PUBLIC", "projection": "emit enum", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^fixture\\.snapshot\\.process\\.(pid|parent_pid|state)$", "class": "SAFE_IDENTIFIER", "projection": "emit synthetic fixture process identity", "threat_ids": ["T-PID-REUSE", "T-TEST-STATE-POLLUTION"]},
    {"field_pattern": "^fixture\\.snapshot\\.process\\.(created_at_unix_nano|boot_id_hash)$", "class": "HASH_ONLY", "projection": "fixture-safe decimal or SHA-256 identity", "threat_ids": ["T-PID-REUSE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^fixture\\.snapshot\\.executable\\.basename$", "class": "SAFE_IDENTIFIER", "projection": "emit safe basename", "threat_ids": ["T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^fixture\\.snapshot\\.executable\\.path_projection$", "class": "LOCAL_EXPLICIT_ONLY", "projection": "allow only $HOME, %USERPROFILE%, or /fixture projection", "threat_ids": ["T-PATH-ESCAPE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^fixture\\.snapshot\\.executable\\.(path_hash|file_id_hash)$", "class": "HASH_ONLY", "projection": "emit prefixed SHA-256", "threat_ids": ["T-PID-REUSE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^fixture\\.snapshot\\.executable\\.image_access$", "class": "PUBLIC", "projection": "emit enum", "threat_ids": ["T-PRIVILEGE-ESCALATION"]},
    {"field_pattern": "^fixture\\.snapshot\\.artifact\\.(status|file_count|byte_count)$", "class": "PUBLIC", "projection": "emit bounded status and aggregates", "threat_ids": ["T-TOCTOU", "T-RESOURCE-EXHAUSTION"]},
    {"field_pattern": "^fixture\\.snapshot\\.artifact\\.(sha256|prior_sha256)$", "class": "HASH_ONLY", "projection": "emit lowercase SHA-256", "threat_ids": ["T-TOCTOU", "T-PROOF-TAMPERING"]},
    {"field_pattern": "^fixture\\.snapshot\\.denied_fields\\[\\]$", "class": "PUBLIC", "projection": "emit bounded field identifier", "threat_ids": ["T-PRIVILEGE-ESCALATION"]},
    {"field_pattern": "^fixture\\.snapshot\\.host_binding\\.(host_id|confidence)$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded host identifier or enum", "threat_ids": ["T-FORGED-EXPECTATION"]},
    {"field_pattern": "^fixture\\.snapshot\\.host_binding\\.config_source_hash$", "class": "HASH_ONLY", "projection": "emit prefixed SHA-256", "threat_ids": ["T-SECRET-DISCLOSURE", "T-FORGED-EXPECTATION"]},
    {"field_pattern": "^fixture\\.expected\\.(verdict|proof_level|reason_codes\\[\\])$", "class": "PUBLIC", "projection": "emit contract vocabulary", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^fixture\\.extensions\\.\\*$", "class": "PROHIBITED", "projection": "omit unless explicitly classified by a later namespaced contract", "threat_ids": ["T-SECRET-DISCLOSURE", "T-CONFIG-EXECUTION"]},

    {"field_pattern": "^proof\\.(schema_version|observed_at|verdict|proof_level|reason_codes\\[\\]|limitations\\[\\])$", "class": "PUBLIC", "projection": "emit exact contract value", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.proof_id$", "class": "PUBLIC", "projection": "emit prefixed SHA-256 proof identifier", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.tool\\.(name|version|commit|toolchain)$", "class": "PUBLIC", "projection": "emit bounded build identity", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.platform\\.(os|arch)$", "class": "PUBLIC", "projection": "emit enum", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.subject\\.(id|display_name|version)$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded subject identity", "threat_ids": ["T-SECRET-DISCLOSURE", "T-FORGED-EXPECTATION"]},
    {"field_pattern": "^proof\\.expectation\\.(source_kind|trust|expected_version)$", "class": "PUBLIC", "projection": "emit enum or bounded declared version", "threat_ids": ["T-FORGED-EXPECTATION"]},
    {"field_pattern": "^proof\\.expectation\\.(source_locator_hash|expected_artifact_sha256)$", "class": "HASH_ONLY", "projection": "emit lowercase SHA-256", "threat_ids": ["T-FORGED-EXPECTATION", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^proof\\.observation\\.process\\.(pid|created_at_unix_nano)$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded local process identity required to prevent PID reuse", "threat_ids": ["T-PID-REUSE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^proof\\.observation\\.process\\.boot_id_hash$", "class": "HASH_ONLY", "projection": "emit prefixed SHA-256", "threat_ids": ["T-PID-REUSE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^proof\\.observation\\.executable\\.basename$", "class": "SAFE_IDENTIFIER", "projection": "emit safe basename", "threat_ids": ["T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^proof\\.observation\\.executable\\.(path_hash|file_id_hash)$", "class": "HASH_ONLY", "projection": "emit prefixed SHA-256", "threat_ids": ["T-PID-REUSE", "T-SECRET-DISCLOSURE"]},
    {"field_pattern": "^proof\\.observation\\.artifact\\.(file_count|byte_count|duration_ms)$", "class": "PUBLIC", "projection": "emit bounded aggregate", "threat_ids": ["T-RESOURCE-EXHAUSTION", "T-TOCTOU"]},
    {"field_pattern": "^proof\\.observation\\.artifact\\.sha256$", "class": "HASH_ONLY", "projection": "emit lowercase SHA-256", "threat_ids": ["T-TOCTOU", "T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.observation\\.inaccessible_fields\\[\\]$", "class": "PUBLIC", "projection": "emit bounded field identifier", "threat_ids": ["T-PRIVILEGE-ESCALATION"]},
    {"field_pattern": "^proof\\.host_attribution\\.(host_id|confidence)$", "class": "SAFE_IDENTIFIER", "projection": "emit bounded host identity or enum", "threat_ids": ["T-FORGED-EXPECTATION"]},
    {"field_pattern": "^proof\\.host_attribution\\.config_source_hash$", "class": "HASH_ONLY", "projection": "emit prefixed SHA-256", "threat_ids": ["T-SECRET-DISCLOSURE", "T-FORGED-EXPECTATION"]},
    {"field_pattern": "^proof\\.evidence\\[\\]\\.(type|observed_at)$", "class": "PUBLIC", "projection": "emit evidence type and UTC observation time", "threat_ids": ["T-PROOF-TAMPERING", "T-TOCTOU"]},
    {"field_pattern": "^proof\\.evidence\\[\\]\\.digest$", "class": "HASH_ONLY", "projection": "emit prefixed SHA-256", "threat_ids": ["T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.privacy\\.(redaction_mode|home_redacted|omitted_fields\\[\\])$", "class": "PUBLIC", "projection": "emit privacy projection metadata", "threat_ids": ["T-SECRET-DISCLOSURE", "T-PROOF-TAMPERING"]},
    {"field_pattern": "^proof\\.extensions\\.\\*$", "class": "PROHIBITED", "projection": "omit unless explicitly classified by a later namespaced contract", "threat_ids": ["T-SECRET-DISCLOSURE", "T-CONFIG-EXECUTION"]}
  ]
}
