{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime-proof.dev/schemas/agent-runtime-proof-1.0.schema.json",
  "title": "Agent Runtime Proof 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof_id", "observed_at", "tool", "platform", "subject", "expectation", "observation", "host_attribution", "verdict", "proof_level", "reason_codes", "evidence", "privacy", "limitations"],
  "properties": {
    "schema_version": {"const": "agent-runtime-proof/1.0"},
    "proof_id": {"$ref": "#/$defs/prefixedSha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "platform": {"$ref": "#/$defs/platform"},
    "subject": {"$ref": "#/$defs/subject"},
    "expectation": {"$ref": "#/$defs/expectationProjection"},
    "observation": {"$ref": "#/$defs/observation"},
    "host_attribution": {"$ref": "#/$defs/hostAttribution"},
    "verdict": {"$ref": "#/$defs/verdict"},
    "proof_level": {"$ref": "#/$defs/proofLevel"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reasonCode"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "privacy": {"$ref": "#/$defs/privacy"},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reasonCode"}},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "verdict": {"enum": ["MATCHED", "STALE", "LEAKED", "CONFLICT", "NOT_RUNNING", "UNKNOWN"]},
    "proofLevel": {"enum": ["PROCESS_OBSERVED", "CONFIG_BOUND", "ARTIFACT_OBSERVED", "LAUNCH_WITNESSED"]},
    "reasonCode": {"enum": ["MATCH_CONFIRMED", "PROCESS_NOT_FOUND", "PROCESS_IDENTITY_CHANGED", "PROCESS_INACCESSIBLE", "EXPECTATION_MISSING", "EXPECTATION_INVALID", "EXPECTATION_UNTRUSTED", "EXPECTATION_AMBIGUOUS", "ARTIFACT_MISMATCH", "ARTIFACT_VERSION_MISMATCH", "ARTIFACT_CHANGED_DURING_READ", "ARTIFACT_SCAN_LIMIT_EXCEEDED", "ARTIFACT_INACCESSIBLE", "ARTIFACT_PATH_ESCAPE", "ARTIFACT_SYMLINK_REJECTED", "ARTIFACT_NORMALIZATION_COLLISION", "ARTIFACT_UNSUPPORTED_TYPE", "POSSIBLE_STALE_AFTER_REPLACEMENT", "STALE_WITNESS_RECEIPT", "RUNTIME_OUTSIDE_ALLOWED_ROOT", "MULTIPLE_ACTIVE_DIGESTS", "HOST_BINDING_AMBIGUOUS", "HOST_CONFIG_INACCESSIBLE", "HOST_CONFIG_INVALID", "WITNESS_EXPECTATION_MISSING", "DYNAMIC_DEPENDENCIES_UNPROVEN", "PLATFORM_EVIDENCE_UNAVAILABLE", "SCAN_CANCELLED"]},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit", "toolchain"],
      "properties": {
        "name": {"const": "agent-runtime-proof"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{7,64}$"},
        "toolchain": {"type": "string", "pattern": "^go[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"enum": ["darwin", "windows", "linux"]},
        "arch": {"enum": ["amd64", "arm64"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "expectationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_locator_hash", "trust", "expected_version", "expected_artifact_sha256"],
      "properties": {
        "source_kind": {"enum": ["release-manifest", "installed-record", "user-file", "host-config"]},
        "source_locator_hash": {"$ref": "#/$defs/sha256"},
        "trust": {"enum": ["verified", "declared", "untrusted"]},
        "expected_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "expected_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "created_at_unix_nano", "boot_id_hash"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "created_at_unix_nano": {"type": "integer", "minimum": 0},
        "boot_id_hash": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "executable", "artifact", "inaccessible_fields"],
      "properties": {
        "process": {"$ref": "#/$defs/processIdentity"},
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["basename", "path_hash"],
          "properties": {
            "basename": {"type": "string", "minLength": 1, "maxLength": 255},
            "path_hash": {"$ref": "#/$defs/prefixedSha256"},
            "file_id_hash": {"$ref": "#/$defs/prefixedSha256"}
          }
        },
        "artifact": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["sha256", "file_count", "byte_count", "duration_ms"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "file_count": {"type": "integer", "minimum": 0},
            "byte_count": {"type": "integer", "minimum": 0},
            "duration_ms": {"type": "integer", "minimum": 0}
          }
        },
        "inaccessible_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}}
      }
    },
    "hostAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "config_source_hash", "confidence"],
      "properties": {
        "host_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "config_source_hash": {"$ref": "#/$defs/prefixedSha256"},
        "confidence": {"enum": ["hint", "correlated", "bound"]}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observed_at"],
      "properties": {
        "type": {"enum": ["process_identity", "config_binding", "artifact_digest", "witness_receipt"]},
        "digest": {"$ref": "#/$defs/prefixedSha256"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redaction_mode", "home_redacted", "omitted_fields"],
      "properties": {
        "redaction_mode": {"const": "safe-default"},
        "home_redacted": {"const": true},
        "omitted_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
      "additionalProperties": true
    }
  }
}
