{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime-proof.dev/schemas/agent-runtime-fixture-1.0.schema.json",
  "title": "Agent Runtime Cross-Platform Fixture 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "platform", "snapshot", "expectation", "expected"],
  "properties": {
    "schema_version": {"const": "agent-runtime-fixture/1.0"},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "platform": {"$ref": "#/$defs/platform"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "expectation": {"$ref": "https://agent-runtime-proof.dev/schemas/agent-runtime-expectation-1.0.schema.json"},
    "expected": {"$ref": "#/$defs/expected"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"enum": ["darwin", "windows", "linux"]},
        "arch": {"enum": ["amd64", "arm64"]}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "created_at_unix_nano", "boot_id_hash", "state"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "created_at_unix_nano": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"},
        "boot_id_hash": {"$ref": "#/$defs/prefixedSha256"},
        "parent_pid": {"type": "integer", "minimum": 1},
        "state": {"enum": ["running", "exited"]}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "path_projection", "path_hash", "image_access"],
      "properties": {
        "basename": {"type": "string", "minLength": 1, "maxLength": 255},
        "path_projection": {"type": "string", "pattern": "^(\\$HOME|%USERPROFILE%|/fixture)(/[^/]+)*$", "maxLength": 4096},
        "path_hash": {"$ref": "#/$defs/prefixedSha256"},
        "file_id_hash": {"$ref": "#/$defs/prefixedSha256"},
        "image_access": {"enum": ["observed", "denied"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sha256", "file_count", "byte_count"],
      "properties": {
        "status": {"enum": ["observed", "inaccessible", "deleted"]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "prior_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 0},
        "byte_count": {"type": "integer", "minimum": 0}
      }
    },
    "hostBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "config_source_hash", "confidence"],
      "properties": {
        "host_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "config_source_hash": {"$ref": "#/$defs/prefixedSha256"},
        "confidence": {"enum": ["hint", "correlated", "bound"]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "executable", "artifact", "denied_fields"],
      "properties": {
        "process": {"$ref": "#/$defs/process"},
        "executable": {"$ref": "#/$defs/executable"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "denied_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}},
        "host_binding": {"$ref": "#/$defs/hostBinding"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "proof_level", "reason_codes"],
      "properties": {
        "verdict": {"$ref": "https://agent-runtime-proof.dev/schemas/agent-runtime-proof-1.0.schema.json#/$defs/verdict"},
        "proof_level": {"$ref": "https://agent-runtime-proof.dev/schemas/agent-runtime-proof-1.0.schema.json#/$defs/proofLevel"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://agent-runtime-proof.dev/schemas/agent-runtime-proof-1.0.schema.json#/$defs/reasonCode"}}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
      "additionalProperties": {"$ref": "#/$defs/extensionValue"}
    },
    "extensionValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "array", "items": {"$ref": "#/$defs/extensionValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/extensionValue"}}
      ]
    }
  }
}
