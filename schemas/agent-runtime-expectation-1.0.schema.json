{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime-proof.dev/schemas/agent-runtime-expectation-1.0.schema.json",
  "title": "Agent Runtime Expectation 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "launch", "artifact", "policy", "source"],
  "properties": {
    "schema_version": {"const": "agent-runtime-expectation/1.0"},
    "subject": {"$ref": "#/$defs/subject"},
    "launch": {"$ref": "#/$defs/launch"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "policy": {"$ref": "#/$defs/policy"},
    "source": {"$ref": "#/$defs/source"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entrypoint", "argument_fingerprints"],
      "properties": {
        "kind": {"enum": ["native", "interpreter-script", "declared-tree"]},
        "entrypoint": {"type": "string", "minLength": 1, "maxLength": 1024},
        "argument_fingerprints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "sha256"],
            "properties": {
              "position": {"type": "integer", "minimum": 0, "maximum": 255},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "include", "exclude", "sha256", "max_files", "max_bytes", "max_duration_ms"],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 4096},
        "include": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "sha256": {"$ref": "#/$defs/sha256"},
        "max_files": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_roots", "allow_symlinks"],
      "properties": {
        "allowed_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "allow_symlinks": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator_hash", "trust"],
      "properties": {
        "kind": {"enum": ["release-manifest", "installed-record", "user-file", "host-config"]},
        "locator_hash": {"$ref": "#/$defs/sha256"},
        "trust": {"enum": ["verified", "declared", "untrusted"]}
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
      "additionalProperties": true
    }
  }
}
