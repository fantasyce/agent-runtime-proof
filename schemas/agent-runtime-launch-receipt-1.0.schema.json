{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime-proof.dev/schemas/agent-runtime-launch-receipt-1.0.schema.json",
  "title": "Agent Runtime Launch Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "created_at", "tool", "platform", "subject", "process", "command", "expectation", "artifact", "observation_only", "reason_codes", "privacy"],
  "properties": {
    "schema_version": {"const": "agent-runtime-launch-receipt/1.0"},
    "receipt_id": {"$ref": "#/$defs/prefixedSha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "platform": {"$ref": "#/$defs/platform"},
    "subject": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/subject"}]},
    "process": {"$ref": "#/$defs/process"},
    "command": {"$ref": "#/$defs/command"},
    "expectation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/expectation"}]},
    "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
    "observation_only": {"type": "boolean"},
    "reason_codes": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"const": "WITNESS_EXPECTATION_MISSING"}},
    "privacy": {"$ref": "#/$defs/privacy"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "commit", "toolchain"],
      "properties": {
        "name": {"const": "agent-runtime-proof"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "commit": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "toolchain": {"type": "string", "pattern": "^go[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[A-Za-z0-9._-]*)$"}
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {"os": {"enum": ["darwin", "windows", "linux"]}, "arch": {"enum": ["amd64", "arm64"]}}
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "display_name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["pid", "created_at_unix_nano", "boot_id_hash"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "created_at_unix_nano": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "boot_id_hash": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "argumentFingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "sha256"],
      "properties": {"position": {"type": "integer", "minimum": 1, "maximum": 255}, "sha256": {"$ref": "#/$defs/prefixedSha256"}}
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["executable_basename", "executable_path_hash", "argument_fingerprints"],
      "properties": {
        "executable_basename": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"},
        "executable_path_hash": {"$ref": "#/$defs/prefixedSha256"},
        "argument_fingerprints": {"type": "array", "maxItems": 255, "items": {"$ref": "#/$defs/argumentFingerprint"}}
      }
    },
    "expectation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "source_locator_hash", "trust", "expected_version", "expected_artifact_sha256"],
      "properties": {
        "source_kind": {"enum": ["release-manifest", "installed-record", "user-file", "host-config"]},
        "source_locator_hash": {"$ref": "#/$defs/sha256"},
        "trust": {"enum": ["verified", "declared", "untrusted"]},
        "expected_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "expected_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "file_count", "byte_count", "duration_ms"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["redaction_mode", "home_redacted", "omitted_fields"],
      "properties": {
        "redaction_mode": {"const": "safe-default"},
        "home_redacted": {"const": true},
        "omitted_fields": {"type": "array", "uniqueItems": true, "items": {"enum": ["command.argv", "process.environment", "process.command_line", "filesystem.paths"]}}
      }
    }
  }
}
