FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=0.1.0 -X main.commit=abcdef0" -o /out/agent-runtime-proof ./cmd/agent-runtime-proof

FROM ubuntu:24.04
COPY --from=build /out/agent-runtime-proof /usr/local/bin/agent-runtime-proof
ENTRYPOINT ["agent-runtime-proof"]
